# HIP POC — production build env (read by Vite at `npm run build`)
# Deployed at https://hip-poc.astrikos.xyz:8443 (frontend port 3367, pm2: hip-poc_3367)
VITE_APP_URL=https://hip-poc.astrikos.xyz:8443

# Basemap style for the Executive View GIS map
VITE_BASEMAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Backend (reserved — this POC has no backend yet; telemetry is simulated in-browser).
# Per deployment_context.md the backend would be port 4367 → hip-poc-api.astrikos.xyz
# VITE_API_URL=https://hip-poc-api.astrikos.xyz:8443
# VITE_SOCKET_URL=https://hip-poc-api.astrikos.xyz:8443
